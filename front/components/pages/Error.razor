@namespace FrontGestionEventos.Components.Pages
@page "/error"
@attribute [AllowAnonymous]

<PageTitle>Error</PageTitle>

<section class="contenedor seccion">
    <h1>Ocurrió un error</h1>
    <p class="texto-suave">
        No fue posible completar la operación solicitada. Vuelva a intentarlo o regrese al inicio.
    </p>
    <a class="boton boton-primario" href="/">Volver al inicio</a>
</section>
