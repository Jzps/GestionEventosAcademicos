# Copie este archivo como ".env" para ajustar la configuración local:
#   cp .env.example .env
#
# Docker Compose lee automáticamente el archivo ".env" de la raíz del proyecto.

# Contraseña de la cuenta "sa" de SQL Server (solo demostración local).
# Debe cumplir la política de complejidad de SQL Server: mayúsculas, minúsculas,
# números y un símbolo, con al menos 8 caracteres.
MSSQL_SA_PASSWORD=GestionEventos2024!

# Clave de firma de los tokens JWT de la API (solo demostración local).
# Debe tener al menos 32 caracteres.
JWT_CLAVE=ClaveDeDemostracion-GestionEventosAcademicos-2024-SoloUsoLocal
