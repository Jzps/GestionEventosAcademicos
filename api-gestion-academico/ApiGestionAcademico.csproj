<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApiGestionAcademico</RootNamespace>
    <AssemblyName>ApiGestionAcademico</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.0" />
  </ItemGroup>

  <!-- La carpeta pruebas/ contiene un proyecto de pruebas independiente: se excluye de la compilación de la API. -->
  <ItemGroup>
    <Compile Remove="pruebas/**" />
    <EmbeddedResource Remove="pruebas/**" />
    <None Remove="pruebas/**" />
    <Content Remove="pruebas/**" />
  </ItemGroup>

  <!-- Las pruebas unitarias acceden a los miembros internos del dominio para construir scenarios. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pruebas.ApiGestionAcademico" />
  </ItemGroup>

</Project>
